      "seed": 1269901758,
      "version": 184,
      "versionNonce": 1099094078,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760121592772,
      "link": null,
      "locked": false,
      "text": "CREATE DATABASE vendas;\n\n-- Tabelas para o banco VENDAS\nCREATE TABLE customers (\n    customer_id character varying(5) NOT NULL PRIMARY KEY,\n    company_name character varying(40) NOT NULL,\n    contact_name character varying(30),\n    contact_title character varying(30),\n    address character varying(60),\n    city character varying(15),\n    region character varying(15),\n    postal_code character varying(10),\n    country character varying(15),\n    phone character varying(24),\n    fax character varying(24)\n);\n\nCREATE TABLE orders (\n    order_id smallint NOT NULL PRIMARY KEY,\n    customer_id character varying(5),\n    employee_id smallint,  -- REFERÊNCIA EXTERNA para rh.employees\n    order_date date,\n    required_date date,\n    shipped_date date,\n    ship_via smallint,     -- REFERÊNCIA EXTERNA para vendas.shippers\n    freight real,\n    ship_name character varying(40),\n    ship_address character varying(60),\n    ship_city character varying(15),\n    ship_region character varying(15),\n    ship_postal_code character varying(10),\n    ship_country character varying(15)\n);\n\nCREATE TABLE order_details (\n    order_id smallint NOT NULL,\n    product_id smallint NOT NULL,  -- REFERÊNCIA EXTERNA para\ncatalogo.products\n    unit_price real NOT NULL,\n    quantity smallint NOT NULL,\n    discount real NOT NULL,\n    PRIMARY KEY (order_id, product_id)\n);\n\nCREATE TABLE shippers (\n    shipper_id smallint NOT NULL PRIMARY KEY,\n    company_name character varying(40) NOT NULL,\n    phone character varying(24)\n);\n\nCREATE TABLE us_states (\n    state_id smallint NOT NULL PRIMARY KEY,\n    state_name character varying(100),\n    state_abbr character varying(2),\n    state_region character varying(50)\n);",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "FpNLrvyhUnHKpN6NZsVLt",
      "originalText": "CREATE DATABASE vendas;\n\n-- Tabelas para o banco VENDAS\nCREATE TABLE customers (\n    customer_id character varying(5) NOT NULL PRIMARY KEY,\n    company_name character varying(40) NOT NULL,\n    contact_name character varying(30),\n    contact_title character varying(30),\n    address character varying(60),\n    city character varying(15),\n    region character varying(15),\n    postal_code character varying(10),\n    country character varying(15),\n    phone character varying(24),\n    fax character varying(24)\n);\n\nCREATE TABLE orders (\n    order_id smallint NOT NULL PRIMARY KEY,\n    customer_id character varying(5),\n    employee_id smallint,  -- REFERÊNCIA EXTERNA para rh.employees\n    order_date date,\n    required_date date,\n    shipped_date date,\n    ship_via smallint,     -- REFERÊNCIA EXTERNA para vendas.shippers\n    freight real,\n    ship_name character varying(40),\n    ship_address character varying(60),\n    ship_city character varying(15),\n    ship_region character varying(15),\n    ship_postal_code character varying(10),\n    ship_country character varying(15)\n);\n\nCREATE TABLE order_details (\n    order_id smallint NOT NULL,\n    product_id smallint NOT NULL,  -- REFERÊNCIA EXTERNA para catalogo.products\n    unit_price real NOT NULL,\n    quantity smallint NOT NULL,\n    discount real NOT NULL,\n    PRIMARY KEY (order_id, product_id)\n);\n\nCREATE TABLE shippers (\n    shipper_id smallint NOT NULL PRIMARY KEY,\n    company_name character varying(40) NOT NULL,\n    phone character varying(24)\n);\n\nCREATE TABLE us_states (\n    state_id smallint NOT NULL PRIMARY KEY,\n    state_name character varying(100),\n    state_abbr character varying(2),\n    state_region character varying(50)\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
